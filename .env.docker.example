# HL7 v2 Message Validator - Docker Environment Configuration Example
# Copy this file to .env and configure your settings

# ==================== APPLICATION MODE ====================
# Choose your deployment mode:
# - 'local': Simple mode - no Azure required, just API key validation
# - 'production': Full mode - requires Azure AD + Azure SQL Database
APP_MODE=local

# ==================== GAZELLE EVS API (REQUIRED) ====================
# Get your API key from: https://testing.ehealthireland.ie
# 1. Register or log in to Gazelle EVS
# 2. Navigate to your profile/settings
# 3. Generate an API key
# 4. Copy it here
GAZELLE_API_KEY=your_gazelle_api_key_here
GAZELLE_API_KEY_VALID_FROM=2026-05-20
GAZELLE_API_KEY_VALID_TO=2027-05-20
GAZELLE_BASE_URL=https://testing.ehealthireland.ie
VERIFY_SSL=true

# ==================== SESSION SECURITY (REQUIRED) ====================
# Generate a secure random key for Flask sessions:
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=your_session_secret_key_here

# ==================== AZURE AD AUTHENTICATION (PRODUCTION MODE ONLY) ====================
# Only required if APP_MODE=production
# Setup steps:
# 1. Go to https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# 2. Click "New registration"
# 3. Name: "HL7 Message Validator"
# 4. Supported account types: "Accounts in this organizational directory only"
# 5. Redirect URI: Web platform, http://localhost:5000/auth/callback
# 6. After registration, copy the following from the Overview page:
AZURE_AD_CLIENT_ID=your_azure_ad_client_id_here
AZURE_AD_TENANT_ID=your_azure_ad_tenant_id_here
# 7. Go to "Certificates & secrets" -> "New client secret" -> Copy the secret value:
AZURE_AD_CLIENT_SECRET=your_azure_ad_client_secret_here
# 8. Configure the redirect URI (must match Azure AD app registration):
AZURE_AD_REDIRECT_URI=http://localhost:5000/auth/callback

# ==================== AZURE SQL DATABASE (PRODUCTION MODE ONLY) ====================
# Only required if APP_MODE=production
# Setup steps:
# 1. Create an Azure SQL Database in the Azure Portal
# 2. Configure firewall rules to allow your IP address
# 3. Copy your connection details:
AZURE_SQL_SERVER=your_server.database.windows.net
AZURE_SQL_DATABASE=your_database_name
AZURE_SQL_USERNAME=your_admin_username
AZURE_SQL_PASSWORD=your_secure_password
DB_DRIVER=FreeTDS

# 4. Generate an encryption key for storing API keys in database:
# Run: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_encryption_key_here

# ==================== AUTO-CORRECTION SETTINGS ====================
MAX_AUTO_CORRECT_ITERATIONS=10
OPEN_REPORT_BROWSER=false

# ==================== OPTIONAL: AZURE MONITORING ====================
# For production monitoring with Azure Application Insights
AZURE_SUBSCRIPTION_ID=
APPINSIGHTS_INSTRUMENTATION_KEY=

# ==================== QUICK START GUIDE ====================
#
# FOR LOCAL MODE (No Azure required):
# 1. Set APP_MODE=local
# 2. Set GAZELLE_API_KEY (from https://testing.ehealthireland.ie)
# 3. Generate SESSION_SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# 4. Run: docker-compose up -d
# 5. Open: http://localhost:5000
#
# FOR PRODUCTION MODE (With Azure):
# 1. Register Azure AD app (see AZURE AD AUTHENTICATION section above)
# 2. Create Azure SQL Database (see AZURE SQL DATABASE section above)
# 3. Set APP_MODE=production
# 4. Configure all AZURE_* variables
# 5. Generate SESSION_SECRET_KEY and ENCRYPTION_KEY
# 6. Run: docker-compose up -d
# 7. Open: http://localhost:5000
# 8. Click "Sign in with Microsoft"
#
# ==================== DEPLOYMENT TO PRODUCTION ====================
#
# When deploying to a public domain (e.g., myapp.azurewebsites.net):
# 1. Update AZURE_AD_REDIRECT_URI to match your domain:
#    AZURE_AD_REDIRECT_URI=https://myapp.azurewebsites.net/auth/callback
# 2. Update the redirect URI in your Azure AD app registration to match
# 3. Update firewall rules in Azure SQL to allow your deployment IP/region
#
